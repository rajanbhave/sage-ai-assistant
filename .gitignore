# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environment
.venv/

# ── Node / Frontend ───────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.git/
frontend/tsconfig*.tsbuildinfo

# ── Secrets & local config ────────────────────────────────────────────
# Local browser identity and endpoint configuration; never commit.
frontend/.env.local

# Generated Gateway target readback; never commit deployment identifiers or credentials.
scripts/gateway_output.json

# Cognito tenant pool IDs, app client IDs, and demo user credentials written by deploy_user_pool.py
# Regenerate by re-running: uv run python scripts/deploy_user_pool.py
scripts/user_pool_output.json

# ── AgentCore generated files ─────────────────────────────────────────
# Generated by `agentcore configure` + `agentcore launch` — contains
# AWS account IDs, IAM role ARNs, runtime ARNs, and local machine paths.
# Regenerate by running: bash scripts/deploy_mcp.sh && bash scripts/deploy_agent.sh
.bedrock_agentcore.yaml
.bedrock_agentcore/

# ── Walkthroughs ──────────────────────────────────────────────────────
walkthroughs/

# ── IDE / OS ──────────────────────────────────────────────────────────
.DS_Store
.vscode/
*.swp
*.swo

# Local tooling and generated artifacts
.hypothesis/
.pi/
.serena/
.specs/
.kiro/references/
.kiro/settings/
kiro-markdown-style/
*.vsix

# Generic secret-bearing files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.credentials
credentials.json
service-account*.json
*-credentials.json
.npmrc
.pypirc
secrets/
keys/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# Generated deployment and local spec evidence
scripts/registry_output.json
.kiro/specs/multi-tenant-agent-identity/.config.kiro
.kiro/specs/multi-tenant-agent-identity/task-*.json
.kiro/specs/multi-tenant-agent-identity/tasks.meta.json
