# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environment
.venv/

# ── Node / Frontend ───────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.git/
frontend/tsconfig*.tsbuildinfo

# ── Secrets & local config ────────────────────────────────────────────
# Local browser identity and endpoint configuration; never commit.
frontend/.env.local

# Generated Gateway target readback; never commit deployment identifiers or credentials.
scripts/gateway_output.json

# Cognito tenant pool IDs, app client IDs, and demo user credentials written by deploy_user_pool.py
# Regenerate by re-running: uv run python scripts/deploy_user_pool.py
scripts/user_pool_output.json

# Internet-reachable Sage API Function URL and issuer list written by deploy_sage_api.py
# Regenerate by re-running: uv run python scripts/deploy_sage_api.py --allow-public-url
scripts/sage_api_output.json

# Per-lane customizer alias ARNs and approved code hashes written by deploy_pre_token_lambda.py
# Regenerate by re-running: uv run python scripts/deploy_pre_token_lambda.py --lane <lane> ...
scripts/pre_token_lambda_output.json

# Lane pool IDs, public client IDs, and demo subjects written by bootstrap_tenant_pool.py
# Regenerate by re-running: uv run python scripts/bootstrap_tenant_pool.py create --lane <lane> ...
scripts/tenant_pool_bootstrap.json

# Pre-teardown reference capture of the retired Phase 1 topology; contains resource identifiers.
scripts/phase1_teardown_snapshot.json

# Generated POC demo user passwords; never commit. Regenerate by recreating the demo users.
scripts/demo_credentials.local.json

# ── AgentCore generated files ─────────────────────────────────────────
# Generated by `agentcore configure` + `agentcore launch` — contains
# AWS account IDs, IAM role ARNs, runtime ARNs, and local machine paths.
# Regenerate by running: bash scripts/deploy_mcp.sh && bash scripts/deploy_agent.sh
.bedrock_agentcore.yaml
.bedrock_agentcore/

# ── Walkthroughs ──────────────────────────────────────────────────────
walkthroughs/

# ── IDE / OS ──────────────────────────────────────────────────────────
.DS_Store
.vscode/
*.swp
*.swo

# Local tooling and generated artifacts
.hypothesis/
.pi/
.serena/
.specs/
.kiro/references/
.kiro/settings/
kiro-markdown-style/
*.vsix

# Generic secret-bearing files
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.credentials
credentials.json
service-account*.json
*-credentials.json
transcript.md
.npmrc
.pypirc
secrets/
keys/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example

# Generated deployment and local spec evidence
scripts/registry_output.json
scripts/identity_deployment.json
scripts/deployment_authorization.json
scripts/legacy_oauth_provider_removal.json
scripts/route_c_validation_report.json
.kiro/review-*.md
.kiro/specs/multi-tenant-agent-identity/.config.kiro
.kiro/specs/multi-tenant-agent-identity/task-*.json
.kiro/specs/multi-tenant-agent-identity/tasks.meta.json
