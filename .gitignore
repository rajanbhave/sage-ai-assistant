# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environment
.venv/

# ── Node / Frontend ───────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.git/
frontend/tsconfig*.tsbuildinfo

# ── Secrets & local config ────────────────────────────────────────────
# Bearer token + agent URL — regenerate with: uv run python scripts/get_token.py
frontend/.env.local

# Live AWS resource ARNs, Cognito client IDs/secrets written by deploy_gateway.py
# Regenerate by re-running: bash scripts/deploy_gateway.sh
scripts/gateway_output.json

# Cognito tenant pool IDs, app client IDs, and demo user credentials written by deploy_user_pool.py
# Regenerate by re-running: uv run python scripts/deploy_user_pool.py
scripts/user_pool_output.json

# ── AgentCore generated files ─────────────────────────────────────────
# Generated by `agentcore configure` + `agentcore launch` — contains
# AWS account IDs, IAM role ARNs, runtime ARNs, and local machine paths.
# Regenerate by running: bash scripts/deploy_mcp.sh && bash scripts/deploy_agent.sh
.bedrock_agentcore.yaml
.bedrock_agentcore/

# ── IDE / OS ──────────────────────────────────────────────────────────
.DS_Store
.vscode/
*.swp
*.swo
