# Committed placeholder topology for tests. Never secrets.
#
# tests/env.py resolves each key in this order:
#   1. os.environ
#   2. the file named by SAGE_TEST_ENV_FILE
#   3. the repository .env (gitignored; put your real deployment values there)
#   4. this file
#
# So a real deployment's identifiers come from .env without editing any test, and
# a fresh clone or CI still runs against these placeholders.

SAGE_TEST_REGION=us-east-1
SAGE_TEST_ACCOUNT_ID=000000000000

SAGE_TEST_TENANT_A_USER_POOL_ID=us-east-1_EXAMPLEAA
SAGE_TEST_TENANT_A_CLIENT_ID=exampleclientidtenanta0000
SAGE_TEST_TENANT_A_MCP_RUNTIME_ID=sage_mcp_tenant_a
SAGE_TEST_TENANT_A_AGENT_RUNTIME_ID=sage_agent_tenant_a
SAGE_TEST_TENANT_A_MCP_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:000000000000:runtime/sage_mcp_tenant_a-EXAMPLE000
SAGE_TEST_TENANT_A_MCP_RUNTIME_QUALIFIER=DEFAULT
SAGE_TEST_TENANT_A_GATEWAY_ID=sage-gw-tenant-a-example00
SAGE_TEST_TENANT_A_GATEWAY_ARN=arn:aws:bedrock-agentcore:us-east-1:000000000000:gateway/sage-gw-tenant-a-example00
SAGE_TEST_TENANT_A_GATEWAY_TARGET_URL=https://sage-gw-tenant-a-example00.gateway.bedrock-agentcore.us-east-1.amazonaws.com/sage-mcp-tenant-a/invocations
SAGE_TEST_TENANT_A_AGENT_RUNTIME_ENDPOINT=https://bedrock-agentcore.us-east-1.amazonaws.com/runtimes/sage_agent_tenant_a-EXAMPLE000/invocations
SAGE_TEST_TENANT_A_PRE_TOKEN_LAMBDA_ARN=arn:aws:lambda:us-east-1:000000000000:function:sage-token-tenant-a:live
SAGE_TEST_TENANT_A_POOL_NAME=sage-tenant-a

SAGE_TEST_TENANT_B_USER_POOL_ID=us-east-1_EXAMPLEBB
SAGE_TEST_TENANT_B_CLIENT_ID=exampleclientidtenantb0000
SAGE_TEST_TENANT_B_MCP_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:000000000000:runtime/sage_mcp_tenant_b-EXAMPLE000
SAGE_TEST_TENANT_B_GATEWAY_ID=sage-gw-tenant-b-example00
